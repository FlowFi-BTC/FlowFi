{
  "name": "02 Business Issue Verify Track",
  "description": "BUSINESS track, runs when workflow 01 gates BUSINESS. Auth (human sign) -> register/get business -> submit receivable -> capture status/verification -> initiate PILOT_REVIEW -> dashboards. Hands receivableId to workflow 03 by human copy once VERIFIED.",
  "environment": "local",
  "steps": [
    {
      "name": "request-challenge",
      "method": "POST",
      "path": "/v1/auth/challenge",
      "description": "CONDITION: run only when workflow 01 gated BUSINESS. Business wallet challenge.",
      "body": {
        "walletAddress": "SP3FBR2AGK5H9QBDH3EEN6DF8EK8JY7RX8QJ5SVTE"
      },
      "capture": {
        "workflow:challengeId": "challengeId"
      },
      "expectStatus": 200
    },
    {
      "name": "verify-signature-HUMAN-INPUT",
      "method": "POST",
      "path": "/v1/auth/verify",
      "description": "HUMAN INPUT: paste business wallet signature.",
      "body": {
        "challengeId": "{{workflow:challengeId}}",
        "walletAddress": "SP3FBR2AGK5H9QBDH3EEN6DF8EK8JY7RX8QJ5SVTE",
        "signature": "0xHUMAN_SIGN_AND_REPLACE_ME"
      },
      "capture": {
        "workflow:accessToken": "token",
        "workflow:userRole": "user.role"
      },
      "expectStatus": 200
    },
    {
      "name": "select-role-business",
      "method": "POST",
      "path": "/v1/onboarding",
      "description": "Lock BUSINESS role.",
      "body": {
        "role": "BUSINESS"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    },
    {
      "name": "register-business",
      "method": "POST",
      "path": "/v1/businesses",
      "description": "Create business profile. If 409 PROFILE_EXISTS, profile already linked: continue to next step manually.",
      "body": {
        "companyName": "ABC Logistics Ltd",
        "registrationNumber": "RC123456",
        "website": "https://abclogistics.com",
        "description": "Logistics company serving West Africa"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "capture": {
        "workflow:businessId": "id"
      },
      "expectStatus": 201
    },
    {
      "name": "get-business-me",
      "method": "GET",
      "path": "/v1/businesses/me",
      "description": "Confirm linked business profile.",
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    },
    {
      "name": "submit-receivable",
      "method": "POST",
      "path": "/v1/receivables",
      "description": "Submit invoice as BUSINESS.",
      "body": {
        "title": "Invoice INV-2041",
        "description": "Logistics services provided to XYZ Corp",
        "invoiceNumber": "INV-2041",
        "amountUsd": 10000,
        "dueDate": "2026-10-20T00:00:00.000Z"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "capture": {
        "workflow:receivableId": "id"
      },
      "expectStatus": 201
    },
    {
      "name": "get-receivable-details",
      "method": "GET",
      "path": "/v1/receivables/:id",
      "description": "CONDITION OUT: capture status and verification for settlement routing.",
      "body": {
        "id": "{{workflow:receivableId}}"
      },
      "capture": {
        "workflow:receivableStatus": "status",
        "workflow:receivableVerification": "verificationStatus"
      },
      "expectStatus": 200
    },
    {
      "name": "initiate-verification",
      "method": "POST",
      "path": "/v1/verification/receivables/:receivableId",
      "description": "Request PILOT_REVIEW for the new receivable.",
      "body": {
        "receivableId": "{{workflow:receivableId}}",
        "method": "PILOT_REVIEW"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "capture": {
        "workflow:verificationId": "id"
      },
      "expectStatus": 201
    },
    {
      "name": "my-receivables",
      "method": "GET",
      "path": "/v1/receivables/me",
      "description": "Business dashboard list check.",
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    },
    {
      "name": "business-dashboard",
      "method": "GET",
      "path": "/v1/dashboard/business",
      "description": "CONDITION OUT: when receivableVerification is VERIFIED, hand receivableId to workflow 03 (human copies it into prepare-funding).",
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    }
  ],
  "generatedAt": "2026-09-11T06:17:56.501Z"
}