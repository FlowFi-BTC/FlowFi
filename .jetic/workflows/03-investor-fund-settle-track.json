{
  "name": "03 Investor Fund Settle Track",
  "description": "INVESTOR + settlement track, runs when workflow 01 gates INVESTOR (or funds workflow 02 output). Auth (human sign) -> investor profile -> marketplace condition pick -> prepare/confirm funding (human txHash) -> portfolio -> repay prepare/confirm (human txHash, else default path) -> proof -> dashboard.",
  "environment": "local",
  "steps": [
    {
      "name": "request-challenge",
      "method": "POST",
      "path": "/v1/auth/challenge",
      "description": "CONDITION: run only when workflow 01 gated INVESTOR (or second wallet funding workflow 02 output).",
      "body": {
        "walletAddress": "SP3FBR2AGK5H9QBDH3EEN6DF8EK8JY7RX8QJ5SVTE"
      },
      "capture": {
        "workflow:challengeId": "challengeId"
      },
      "expectStatus": 200
    },
    {
      "name": "verify-signature-HUMAN-INPUT",
      "method": "POST",
      "path": "/v1/auth/verify",
      "description": "HUMAN INPUT: paste investor wallet signature.",
      "body": {
        "challengeId": "{{workflow:challengeId}}",
        "walletAddress": "SP3FBR2AGK5H9QBDH3EEN6DF8EK8JY7RX8QJ5SVTE",
        "signature": "0xHUMAN_SIGN_AND_REPLACE_ME"
      },
      "capture": {
        "workflow:accessToken": "token"
      },
      "expectStatus": 200
    },
    {
      "name": "select-role-investor",
      "method": "POST",
      "path": "/v1/onboarding",
      "description": "Lock INVESTOR role.",
      "body": {
        "role": "INVESTOR"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    },
    {
      "name": "register-investor",
      "method": "POST",
      "path": "/v1/investors",
      "description": "Create investor profile. If 409 PROFILE_EXISTS, continue manually.",
      "body": {
        "displayName": "Prudence Capital"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "capture": {
        "workflow:investorId": "id"
      },
      "expectStatus": 201
    },
    {
      "name": "get-investor-me",
      "method": "GET",
      "path": "/v1/investors/me",
      "description": "Confirm linked investor profile.",
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    },
    {
      "name": "browse-marketplace",
      "method": "GET",
      "path": "/v1/marketplace/receivables",
      "description": "CONDITION: pick an OPEN_FOR_FUNDING + VERIFIED item. HUMAN INPUT its id into prepare-funding.",
      "expectStatus": 200
    },
    {
      "name": "prepare-funding",
      "method": "POST",
      "path": "/v1/fundings/prepare",
      "description": "HUMAN INPUT: replace receivableId with workflow 02 output or marketplace pick.",
      "body": {
        "receivableId": "rec_112233",
        "amountSbtc": "0.15"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "capture": {
        "workflow:fundingId": "fundingId"
      },
      "expectStatus": 200
    },
    {
      "name": "confirm-funding-HUMAN-INPUT",
      "method": "POST",
      "path": "/v1/fundings/confirm",
      "description": "HUMAN INPUT: broadcast fund-receivable in wallet, paste real txHash.",
      "body": {
        "fundingId": "{{workflow:fundingId}}",
        "txHash": "0xHUMAN_TXHASH_REPLACE_ME"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "capture": {
        "workflow:fundTxHash": "txHash"
      },
      "expectStatus": 200
    },
    {
      "name": "my-fundings",
      "method": "GET",
      "path": "/v1/fundings/me",
      "description": "Investor portfolio check.",
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    },
    {
      "name": "prepare-repayment",
      "method": "POST",
      "path": "/v1/fundings/:id/repayment/prepare",
      "description": "Business-side repay payload (same or business token).",
      "body": {
        "id": "{{workflow:fundingId}}"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    },
    {
      "name": "confirm-repayment-HUMAN-INPUT",
      "method": "POST",
      "path": "/v1/fundings/:id/repayment/confirm",
      "description": "HUMAN INPUT: broadcast repay in wallet, paste real txHash. CONDITION: on success status REPAID; on default path use flag-default instead.",
      "body": {
        "id": "{{workflow:fundingId}}",
        "txHash": "0xHUMAN_REPAY_TXHASH_REPLACE_ME"
      },
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    },
    {
      "name": "tx-proof",
      "method": "GET",
      "path": "/v1/transactions/:txHash",
      "description": "Verify on-chain proof of funding tx.",
      "body": {
        "txHash": "{{workflow:fundTxHash}}"
      },
      "expectStatus": 200
    },
    {
      "name": "investor-dashboard",
      "method": "GET",
      "path": "/v1/dashboard/investor",
      "description": "Final investor metrics.",
      "inject": {
        "header:Authorization": "workflow:accessToken"
      },
      "expectStatus": 200
    }
  ],
  "generatedAt": "2026-09-11T06:18:07.525Z"
}